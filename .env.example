# C1 API Configuration (Optional - for enhanced generative UI)
THESYS_API_KEY=your_thesys_api_key_here

# Provider API Keys
# At least OPENAI_API_KEY is REQUIRED for the app to work
OPENAI_API_KEY=your_openai_api_key_here

# Optional additional providers (for fallback chain)
GOOGLE_API_KEY=your_google_api_key_here
MINIMAX_API_KEY=your_minimax_api_key_here
WAVESPEED_API_KEY=your_wavespeed_api_key_here
KIMI_API_KEY=your_kimi_api_key_here
QWEN_API_KEY=your_qwen_api_key_here

# Optional: Set primary provider (default: openai)
PRIMARY_PROVIDER=openai

# Rate Limiting with Upstash Redis (Optional but recommended for production)
# Sign up at https://upstash.com and create a Redis database
# Leave empty to disable rate limiting (allows unlimited requests)
UPSTASH_REDIS_REST_URL=your_upstash_redis_url_here
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token_here

# GitHub Integration (Optional - for Gist export feature)
# Users can provide their own token when exporting, or you can set a default
# GITHUB_TOKEN=your_github_personal_access_token_here
